# Copy this file to supabase/functions/.env and fill in real values.
# supabase/functions/.env is gitignored (matched by the root .gitignore
# ".env" rule) and holds server-side config for the analyze-shot Edge
# Function. The Groq key is created and held by a human, never committed
# and never exposed to the client.

# Groq API key, from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Groq model id for the barista assistant. Check what your key can use with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Prefer a standard instruction model. A reasoning model spends the
# max_tokens budget on its hidden reasoning trace before emitting the JSON
# and the response then fails validation; analyze-shot pins
# reasoning_effort to "low" so the gpt-oss models still fit that budget, but
# a plain instruction model needs no such tuning.
GROQ_MODEL=openai/gpt-oss-120b

# Optional. Overrides the Groq API base URL (for a local mock during
# development). Defaults to https://api.groq.com/openai/v1 when unset.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

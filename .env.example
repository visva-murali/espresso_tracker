# Copy this file to .env and fill in real values. .env is gitignored and
# must be created fresh in every checkout/worktree - it is never copied by git.

# Supabase project URL and anon key, from the Supabase dashboard:
# Settings > API > Project URL / Project API keys > anon public
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only needed for the integration tests under tests/integration/, which run
# against a LOCAL Supabase instance (via `npx supabase start`, requires
# Docker), not the hosted project. Get this key from `npx supabase status`.
SUPABASE_LOCAL_SERVICE_ROLE_KEY=

# The barista assistant's Groq API key is NOT a frontend variable and must
# never be placed in this file or .env - Vite would bundle it into the
# client. It belongs in supabase/functions/.env; see
# supabase/functions/.env.example.
